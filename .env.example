# ── Server ──────────────────────────────
# Required for production – change this to a long random string!
JWT_SECRET=zfast_super_secret_change_this_in_production_2024

# Port (hosting platforms set this automatically, leave as-is)
PORT=3000

# Optional: your domain (for CORS if needed)
# ALLOWED_ORIGIN=https://your-domain.com

# ── Storage (Hugging Face Spaces Persistent Storage) ───
# In HF Spaces with persistent storage, use /data
DATA_DIR=/data
UPLOADS_DIR=/data/uploads
